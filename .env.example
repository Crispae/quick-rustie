# Local MinIO (rustie-minio). Copy to .env if you want dotenv tooling.
MINIO_ENDPOINT=http://127.0.0.1:9010
MINIO_BUCKET=rustie-dev
MINIO_PREFIX=quick-rustie
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Avoids ~3s of EC2-metadata probing (and warnings) in the AWS SDK; the rustie-index CLI sets this itself.
AWS_EC2_METADATA_DISABLED=true
