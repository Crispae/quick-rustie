# Copy to .env (gitignored) and fill in. Read by scripts/local-cluster.sh and docker compose.
S3_ENDPOINT=https://<region>.contabostorage.com   # your provider's S3 URL
S3_REGION=<region>                                # region your provider signs with
S3_ACCESS_KEY=
S3_SECRET_KEY=
PG_PASSWORD=rustie                                # local rustie-postgres container default
